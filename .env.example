# MangoCode local development environment.
# Copy this file to server/.env and fill only the values you use.
# Never commit real credentials or place server secrets in VITE_* variables.

DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"
SESSION_SECRET="generate-with-openssl-rand-base64-48"
OTP_SECRET=""
OWNER_EMAIL=""

# Google Identity Services Web Client ID (public ID; no client secret is needed for this ID-token flow).
GOOGLE_CLIENT_ID=""
VITE_GOOGLE_CLIENT_ID=""

CLIENT_URL="http://localhost:5173"
PORT=4000

# Zoho Mail SMTP can be configured in /admin > Email delivery.
# Use the exact hostname shown in Zoho Mail account settings.
# Port 465 = SSL (SMTP_SECURE=true); port 587 = TLS/STARTTLS (false).
# Use an app-specific password if Zoho requires one.
SMTP_HOST=""
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""
SMTP_FROM_NAME="MangoCode"

SUPPORT_EMAIL=""
DISCORD_BUG_WEBHOOK=""
PISTON_URL="https://emkc.org/api/v2/piston"

# Razorpay secrets and the UPI VPA are configured in /admin > Payments.
# Do not add RAZORPAY_KEY_SECRET or UPI credentials to VITE_* variables.
