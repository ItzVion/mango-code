# Neon PostgreSQL connection string (use the pooled URL for the Vercel app).
DATABASE_URL=""

# Used to HMAC short-lived email codes. Generate a random value of at least 32 characters.
SESSION_SECRET="replace-with-a-long-random-secret"
# Optional: if omitted, SESSION_SECRET is used for one-time-code hashing.
OTP_SECRET=""

# Promote exactly this existing/new account to OWNER after sign-in.
OWNER_EMAIL=""

# Google Identity Services: the same Web client ID is used by browser and server.
GOOGLE_CLIENT_ID=""

# SMTP settings for verification and password-reset emails.
SMTP_HOST=""
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""
SMTP_FROM_NAME="MangoCode"

# Discord webhook for the in-app bug-report form. Use a newly rotated webhook.
DISCORD_BUG_WEBHOOK=""

# Public support contact shown on legal pages (must be a real, monitored inbox).
SUPPORT_EMAIL=""

# Optional override for the Piston code runner.
PISTON_URL="https://emkc.org/api/v2/piston"

PORT=4000
CLIENT_URL="https://mangocode.vercel.app"
